{
  "name": "hypergx",
  "version": "0.1.0",
  "private": true,
  "description": "HyperGX - An OperaGX-inspired Electron browser with full local storage",
  "main": "dist/main/main.js",
  "author": "HyperGX Team",
  "license": "MIT",
  "scripts": {
    "dev": "run-p dev:renderer dev:main",
    "dev:renderer": "vite --config app/renderer/vite.config.ts",
    "dev:main": "ts-node --project tsconfig.main.json app/main/dev-runner.ts",
    "build:ui": "vite build --config app/renderer/vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build": "npm run build:main && npm run build:preload && npm run build:ui && electron-builder --config electron-builder.yml",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.26.6",
    "@radix-ui/react-icons": "^1.3.0",
    "autoprefixer": "^10.4.17",
    "classnames": "^2.3.2",
    "electron": "^28.3.1",
    "framer-motion": "^10.16.4",
    "node-fetch": "^2.6.12",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@types/classnames": "^2.3.1",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "concurrently": "^8.2.2",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.1.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.1.1",
    "wait-on": "^7.1.0"
  }
}
