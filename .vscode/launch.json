{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode/master/extensions/debugger-for-chrome/README.md",
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron: Main",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "runtimeArgs": [
        "dist/main/main.js"
      ],
      "cwd": "${workspaceFolder}",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      }
    }
  ]
}
